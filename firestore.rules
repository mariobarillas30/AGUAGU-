rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Configuración general de la tienda
    match /config/{docId} {
      allow read, write: if true;
    }
    
    // Inventario general de productos
    match /products/{productId} {
      allow read, write: if true;
    }
    
    // Productos extra para venta cruzada
    match /extra_products/{extraId} {
      allow read, write: if true;
    }
    
    // Mesas de regalo y sus items
    match /gift_tables/{tableId} {
      allow read, write: if true;
      
      // Subcolección de items de la mesa
      match /table_items/{itemId} {
        allow read, write: if true;
      }
    }
  }
}

