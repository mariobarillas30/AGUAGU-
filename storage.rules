rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Reglas para fotografías de productos de inventario
    match /products/{productId}/{imageFile} {
      // Los visitantes del catálogo pueden ver y descargar las imágenes libremente
      allow read: if true;
      
      // Solo administradores autenticados pueden subir, actualizar o eliminar imágenes
      // Validando que sea imagen válida y no supere los 10MB
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      
      // Permitir eliminación a usuarios autenticados
      allow delete: if request.auth != null;
    }

    // Reglas para fotografías de productos extras (detalles y complementos)
    match /extra_products/{extraId}/{imageFile} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // Regla de fallback segura para el resto de archivos
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
